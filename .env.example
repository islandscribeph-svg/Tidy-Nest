# Postgres connection strings. Works with any Postgres, including Supabase's
# "Connect" dialog > ORM tab (Prisma), which gives you both of these:
# - DATABASE_URL: pooled connection (port 6543) — used at runtime by the app
# - DIRECT_URL: direct connection (port 5432) — used only by `prisma migrate`,
#   since schema changes (DDL) aren't reliable through a transaction pooler
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Random secret used to sign staff login session cookies, and to gate the
# one-time /api/setup/* bootstrap endpoints (see README).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-string"

# Shared secret the website form (or any external intake integration) must
# send as the `x-intake-key` header when POSTing to /api/leads/intake.
LEAD_INTAKE_SECRET="change-me-to-a-random-string"

# Exactly two staff emails, comma-separated. Login rejects every other address
# with the same "Invalid email or password" response. Both accounts are created
# by `npm run sandbox:setup` or by calling POST /api/setup/admin twice.
ALLOWED_USER_EMAILS="owner.one@example.com,owner.two@example.com"

# Used by `npm run sandbox:setup`. Passwords are never printed.
SANDBOX_USER_1_NAME="Owner One"
SANDBOX_USER_1_EMAIL="owner.one@example.com"
SANDBOX_USER_1_PASSWORD="change-me-1"
SANDBOX_USER_2_NAME="Owner Two"
SANDBOX_USER_2_EMAIL="owner.two@example.com"
SANDBOX_USER_2_PASSWORD="change-me-2"

# Optional. `npm run db:seed` still creates one admin if you use it instead of
# the two-account sandbox setup. That email must be on ALLOWED_USER_EMAILS.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="you@tidynest.com"
SEED_ADMIN_PASSWORD="change-me"

# Local JSON snapshot of Monday items_page output. Not a URL. The app never
# calls Monday and must not be given a Monday token. Leave unset until you
# have a snapshot file on this machine. See SANDBOX.md.
MONDAY_SNAPSHOT_PATH=""

# Display-name replacements applied after import, at display, search, and
# export. Harborlane is a fake example name, not a client. Put the real
# family surname only in this private env value, never in the repo.
CLIENT_ALIAS_MAP={"Harborlane":"Market Street"}

# Optional comma-separated names for POST /api/setup/seed-employees when the
# request body does not include names.
SEED_EMPLOYEE_NAMES=""

# Brand. Defaults are the olive bar and the white wordmark.
NEXT_PUBLIC_BRAND_COLOR="#5c6b3f"
NEXT_PUBLIC_BRAND_LOGO_PATH="/brand/tidynest-logo-white.webp"

# Resend (resend.com) API key, used to send "forgot password" emails.
# Without a verified sending domain, Resend can only deliver to the email
# address you signed up with — see README for details. Left unset in local
# dev, reset links are just logged to the console instead of emailed.
RESEND_API_KEY=""
# "from" address for those emails — must be on a domain verified with Resend
# (or leave unset to use Resend's default onboarding@resend.dev sender).
EMAIL_FROM="Tidy Nest <onboarding@resend.dev>"

# Settings and integrations. Every integration stays off until its flag is 1
# and its secrets are set. Do not commit real values.
BACKUP_CRON_SECRET=""
GOOGLE_SHEETS_BACKUP_ENABLED=""
GOOGLE_SHEETS_BACKUP_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
SLACK_NOTIFICATIONS_ENABLED=""
SLACK_WEBHOOK_URL=""
GOOGLE_CALENDAR_SYNC_ENABLED=""
GOOGLE_CALENDAR_ID=""
APP_ORIGIN="http://127.0.0.1:3000"
