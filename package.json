{
  "name": "tidy-nest",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:cloudflare": "prisma generate && opennextjs-cloudflare build && node scripts/patch-cloudflare-middleware.mjs",
    "preview:cloudflare": "prisma generate && opennextjs-cloudflare build && node scripts/patch-cloudflare-middleware.mjs && wrangler dev",
    "deploy": "prisma migrate deploy && prisma generate && opennextjs-cloudflare build && node scripts/patch-cloudflare-middleware.mjs && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "import:monday": "tsx scripts/migrate-monday-export.ts",
    "import:snapshot": "tsx scripts/import-snapshot.ts",
    "sandbox:setup": "tsx scripts/sandbox-setup.ts",
    "sandbox:start": "next dev",
    "sandbox:start:prod": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/monday/snapshot.test.ts src/lib/core.test.ts src/lib/alias-routes.test.ts src/lib/brand-assets.test.ts src/lib/client-report.test.ts src/lib/exports.test.ts src/lib/filter-presets.test.ts src/lib/field-edits.test.ts src/lib/reports.test.ts src/lib/integrations.test.ts src/lib/v2.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.18",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "^16.4.6",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "exceljs": "^4.4.0",
    "resend": "^6.27.0",
    "tailwind-merge": "^3.6.0",
    "wrangler": "^4.166.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
