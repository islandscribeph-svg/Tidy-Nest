// Tidy Nest CRM/PM — Prisma schema
// See /root/.claude/plans (or PLAN.md at repo root) for the design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Supabase transaction pooler, port 6543) — used at runtime
  directUrl = env("DIRECT_URL")   // direct connection (port 5432) — used by `prisma migrate` only, since DDL doesn't work reliably through a transaction pooler
}

enum Role {
  ADMIN
  STAFF
}

// Pipeline stage. NEW_LEAD..CLOSED is the "happy path"; UNQUALIFIED and DEAD
// are exit states reachable from any stage (they are not steps after CLOSED).
enum Stage {
  NEW_LEAD
  CONTACTED
  CONSULTATION
  IN_PROGRESS
  CLOSED
  UNQUALIFIED
  DEAD
}

enum ServiceType {
  ORGANIZING
  RELOCATION
  HOME_MANAGEMENT
  HOLIDAY_BOX
  MAINTENANCE
  OTHER
}

// Normalized source categories. sourceDetail on Deal carries the free-text
// specifics (e.g. "Referral- Sabbath") without polluting this enum, so
// reporting on `source` stays reliable while detail isn't lost.
enum Source {
  SOCIAL_MEDIA
  REFERRAL
  MAGAZINE
  ONLINE_AD
  GOOGLE
  FRIEND
  WEBSITE
  OTHER
  UNKNOWN
}

enum FileType {
  PROPOSAL
  CONTRACT
  INVOICE
  CONSULT_INVOICE
  OTHER
}

enum EmployeeType {
  EMPLOYEE
  CONTRACTOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  assignedDeals Deal[] @relation("DealAssignee")
  notes         Note[]
}

model Contact {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String?
  email         String?
  phone         String?
  streetAddress String?
  city          String?
  state         String?
  company       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deals Deal[]

  @@index([email])
  @@index([phone])
}

// One pipeline item = one project (e.g. "Fall Relocation") for a Contact.
// A Contact can have many Deals over time (repeat clients).
model Deal {
  id        String  @id @default(cuid())
  contact   Contact @relation(fields: [contactId], references: [id])
  contactId String

  stage        Stage   @default(NEW_LEAD)
  subStatus    String? // free text, scoped per stage (e.g. "Initial Email Sent")
  contactSaved Boolean @default(false) // true once required contact fields have been confirmed via the Save Contact flow

  title            String? // the project title shown on the pipeline card, e.g. "Fall Relocation"
  serviceType      ServiceType?
  detailsOfProject String?

  source       Source  @default(UNKNOWN)
  sourceDetail String?

  estimatedDealValue Decimal? @db.Decimal(10, 2)
  closedDealValue    Decimal? @db.Decimal(10, 2)
  consultFee         Decimal? @db.Decimal(10, 2)

  consultDate      DateTime?
  projectStartDate DateTime?
  dateClosed       DateTime?

  // Consultation tab: manual bridge to QuickBooks until real API integration exists
  consultInvoiceNumber String?
  consultInvoiceLink   String?

  // Services Worksheet tab
  worksheetNotes String?

  // Total Billables tab: manual bridge to QuickBooks for the final project invoice
  invoiceLink String?

  // Legacy QuickBooks linkage fields carried over from the Monday import (deeper sync deferred)
  invoiceNumber        String?
  qbDepositPaymentLink String?
  qbFinalPaymentLink   String?

  assignedTo   User?   @relation("DealAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes                Note[]
  files                File[]
  checklistItems       ChecklistItem[]
  worksheetEntries     WorksheetEntry[]
  reimbursementVendors ReimbursementVendor[]
  additionalCharges    AdditionalCharge[]

  @@index([stage])
  @@index([contactId])
}

// Consultation tab checklist.
model ChecklistItem {
  id        String   @id @default(cuid())
  deal      Deal     @relation(fields: [dealId], references: [id])
  dealId    String
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Services Worksheet tab line item: Person / Date / Description / Hours /
// Rate. `rate` is the PROJECT's billing rate charged to the client — the
// row total (hours × rate) is computed, not stored. When `employee` is set,
// these same hours also appear on that person's timesheet, valued instead
// at their own hourlyRate (looked up live, not snapshotted here).
model WorksheetEntry {
  id          String    @id @default(cuid())
  deal        Deal      @relation(fields: [dealId], references: [id])
  dealId      String
  employee    Employee? @relation(fields: [employeeId], references: [id])
  employeeId  String?
  date        DateTime?
  description String
  hours       Decimal   @db.Decimal(10, 2)
  rate        Decimal   @db.Decimal(10, 2)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
}

// Employees/Contractors section. hourlyRate is what THIS person is paid —
// independent of whatever project-billing rate appears on WorksheetEntry
// rows attributed to them.
model Employee {
  id         String       @id @default(cuid())
  name       String
  type       EmployeeType @default(CONTRACTOR)
  hourlyRate Decimal      @db.Decimal(10, 2)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  timesheetEntries TimesheetEntry[]
  worksheetEntries WorksheetEntry[]
}

// Manually-entered timesheet hours, not tied to any project. Project-sourced
// hours live on WorksheetEntry (via employeeId) instead of being duplicated
// here, so there's exactly one row to edit either way.
model TimesheetEntry {
  id          String   @id @default(cuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  date        DateTime
  hours       Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now())
}

// Total Billables tab: ad hoc extra line items beyond service hours + reimbursements.
model AdditionalCharge {
  id          String  @id @default(cuid())
  deal        Deal    @relation(fields: [dealId], references: [id])
  dealId      String
  description String
  amount      Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0)
}

// Reimbursements tab: one vendor block per entry, each with its own line
// items. shippingFee/salesTax are flat dollar amounts staff fills in.
// Subtotal/grand total (and the cross-vendor overview) are computed.
model ReimbursementVendor {
  id          String   @id @default(cuid())
  deal        Deal     @relation(fields: [dealId], references: [id])
  dealId      String
  vendorName  String
  shippingFee Decimal  @default(0) @db.Decimal(10, 2)
  salesTax    Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  items ReimbursementItem[]
}

model ReimbursementItem {
  id          String              @id @default(cuid())
  vendor      ReimbursementVendor @relation(fields: [vendorId], references: [id])
  vendorId    String
  itemDetails String
  quantity    Decimal             @db.Decimal(10, 2)
  unitPrice   Decimal             @db.Decimal(10, 2)
  sortOrder   Int                 @default(0)
}

// Activity/note timeline entry. Attached to a Deal and/or Contact so both
// the pipeline item and the underlying person keep a shared audit trail.
model Note {
  id        String   @id @default(cuid())
  body      String
  deal      Deal?    @relation(fields: [dealId], references: [id])
  dealId    String?
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  createdAt DateTime @default(now())
}

model File {
  id         String   @id @default(cuid())
  deal       Deal     @relation(fields: [dealId], references: [id])
  dealId     String
  type       FileType @default(OTHER)
  url        String
  fileName   String
  uploadedAt DateTime @default(now())
}
